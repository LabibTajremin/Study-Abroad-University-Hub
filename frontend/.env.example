# Required Vercel environment variables for the admin tool's serverless functions
# (Project Settings -> Environment Variables in the Vercel dashboard).
# These are server-side only — never shipped to the browser bundle.

# Admin login credentials, checked in api/admin/login.ts
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secret used to sign/verify the admin session token (any long random string)
ADMIN_JWT_SECRET=

# GitHub personal access token with "repo" (or fine-grained Contents:write)
# scope on this repository — used to commit admin edits directly via the
# GitHub Contents API, which then triggers a normal Vercel deploy.
GITHUB_TOKEN=
GITHUB_OWNER=LabibTajremin
GITHUB_REPO=Study-Abroad-University-Hub
GITHUB_BRANCH=main
